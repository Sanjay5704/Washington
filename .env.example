# Copy to .env and fill in. Never commit .env.

# SEC fair-access policy: identify yourself as "<app name> <contact email>"
SEC_USER_AGENT="Washington your.email@example.com"
# SEC allows max 10 req/s; we stay well under it.
SEC_MAX_REQUESTS_PER_SECOND=6

# PostgreSQL warehouse (silver + gold) and Airflow metadata DB share one server
POSTGRES_USER=washington
POSTGRES_PASSWORD=change_me
POSTGRES_DB=washington
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MinIO (bronze layer)
MINIO_ROOT_USER=washington
MINIO_ROOT_PASSWORD=change_me_too
MINIO_ENDPOINT=http://minio:9000
BRONZE_BUCKET=bronze

# Airflow UI login (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin
AIRFLOW_SECRET_KEY=change_me_secret

# Cluster definition (passed to dbt as vars)
CLUSTER_MIN_INSIDERS=3
CLUSTER_WINDOW_DAYS=10
CLUSTER_MIN_VALUE_USD=250000

# Backfill range for the PySpark job (SEC quarterly Form 3/4/5 data sets)
BACKFILL_START_QUARTER=2021q2
BACKFILL_END_QUARTER=2026q1

# Optional Telegram alerts: leave empty to disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
